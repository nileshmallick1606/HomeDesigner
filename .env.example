# Database
DATABASE_URL=postgresql://interior:interior_dev@localhost:5432/interior_science
POSTGRES_USER=interior
POSTGRES_PASSWORD=interior_dev
POSTGRES_DB=interior_science

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-long-random-string

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=interior-science
R2_PUBLIC_URL=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@interiorscience.app

# Encryption
ENCRYPTION_KEY=change-me-32-byte-hex-key-for-aes256

# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
